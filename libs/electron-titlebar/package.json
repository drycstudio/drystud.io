{
  "name": "@drycstud.io/electron-titlebar",
  "version": "2.1.0",
  "main": "dist/main.js",
  "module": "dist/main.mjs",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.mjs",
      "require": "./dist/main.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "config.d.ts",
    "electron.d.ts",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "description": "A pretty way to add Titlebar in a Electron app using ReactJS",
  "keywords": [
    "awesome",
    "pretty",
    "electron",
    "react",
    "titlebar",
    "menu",
    "plugin"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com/drycstudio"
  },
  "repository": {
    "type": "git",
    "url": "https://www.github.com/drycstudio/drystud.io"
  },
  "author": "euclidesdry <euclidesdry@gmail.com>",
  "packageManager": "yarn@4.3.1",
  "scripts": {
    "ci": "yarn install && yarn lint && yarn test",
    "dev": "vite",
    "build": "tsc --p ./tsconfig.build.json && vite build",
    "preview": "tsc --p ./tsconfig.build.json && vite preview",
    "build:with-storybook": "yarn build && yarn build-storybook",
    "publish:package": "yarn npm publish --access public",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.{js,jsx,ts,tsx,json}",
    "lint:fix": "eslint --fix src/**/*.{js,jsx,ts,tsx,json}",
    "lint:format": "prettier --write src/**/*.{js,jsx,ts,tsx,css,md,json} --config ./.prettierrc",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --docs",
    "storybook:docs": "storybook dev --docs",
    "build-storybook": "storybook build",
    "prepublishOnly": "yarn build"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "electron": ">=31.0.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-icons": "^5.2.1"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@stitches/core": "^1.2.8",
    "@stitches/react": "^1.2.8",
    "is-electron": "^2.2.2",
    "react-helmet-async": "^2.0.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-onboarding": "^10.2.10",
    "@storybook/addon-vitest": "^10.2.10",
    "@storybook/react": "^10.2.10",
    "@storybook/react-vite": "^10.2.10",
    "@testing-library/dom": "^10.3.2",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "c8": "^10.1.3",
    "electron": "^40.6.0",
    "eslint": "10.0.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-config-universe": "^15.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.2.10",
    "eslint-plugin-styled-components-a11y": "^2.2.1",
    "globals": "^17.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "prettier": "3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-test-renderer": "^19.2.4",
    "rollup-plugin-rm": "^1.0.2",
    "sass": "^1.97.3",
    "storybook": "^10.2.10",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
